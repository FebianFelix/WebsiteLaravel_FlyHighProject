# FlyHigh v2.0 standalone offline demo; copy into .env, never commit .env.
APP_NAME="FlyHigh Demo"
APP_ENV=demo
APP_KEY=
APP_DEBUG=false
APP_URL=http://127.0.0.1:8000
LOG_CHANNEL=stack
LOG_LEVEL=warning

DB_CONNECTION=sqlite
DB_DATABASE=database/demo.sqlite
DB_FOREIGN_KEYS=true
CACHE_STORE=file
SESSION_DRIVER=file
SESSION_LIFETIME=120
QUEUE_CONNECTION=sync
MAIL_MAILER=log
FILESYSTEM_DISK=local

FLYHIGH_DEMO_PAYMENTS=true
FLYHIGH_PAYMENT_GATEWAY=disabled
FLYHIGH_HOLD_MINUTES=15
FLYHIGH_TAX_PERCENT=0
FLYHIGH_DEMO_PASSWORD=DemoPass123!
DUFFEL_ACCESS_TOKEN=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
