# EXAMPLE ONLY. Place an actual .env on the development SERVER, not in Git.
APP_NAME=FlyHigh-Dev
APP_ENV=development
APP_KEY=
APP_DEBUG=false
APP_URL=https://dev.your-flyhigh-domain.example
LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=dev-db-host
DB_PORT=3306
DB_DATABASE=flyhigh_development
DB_USERNAME=flyhigh_dev
DB_PASSWORD=

CACHE_STORE=file
SESSION_DRIVER=file
SESSION_COOKIE=flyhigh_development_session
SESSION_SECURE_COOKIE=true
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

MAIL_MAILER=log
MAIL_FROM_ADDRESS=noreply@dev.your-flyhigh-domain.example
MAIL_FROM_NAME=FlyHigh-Dev

FLYHIGH_DEMO_PAYMENTS=true
FLYHIGH_HOLD_MINUTES=15
FLYHIGH_BOOKING_MODE=simulation

# Optional provider integrations: never store secrets in Git.
FLYHIGH_PAYMENT_GATEWAY=disabled
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
FLYHIGH_FLIGHT_PROVIDER=disabled
DUFFEL_ACCESS_TOKEN=
FLYHIGH_TAX_PERCENT=0
