# EXAMPLE ONLY. Place an actual .env on the production SERVER, not in Git.
APP_NAME=FlyHigh
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-flyhigh-domain.example
LOG_CHANNEL=stack
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=prod-db-host
DB_PORT=3306
DB_DATABASE=flyhigh_production
DB_USERNAME=flyhigh_prod
DB_PASSWORD=

CACHE_STORE=file
SESSION_DRIVER=file
SESSION_COOKIE=flyhigh_production_session
SESSION_SECURE_COOKIE=true
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@your-flyhigh-domain.example
MAIL_FROM_NAME=FlyHigh

# No real payment gateway is integrated. Keep simulator off in production.
FLYHIGH_DEMO_PAYMENTS=false
FLYHIGH_HOLD_MINUTES=15

# Optional provider integrations: never store secrets in Git.
FLYHIGH_PAYMENT_GATEWAY=disabled
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
FLYHIGH_FLIGHT_PROVIDER=disabled
DUFFEL_ACCESS_TOKEN=
FLYHIGH_TAX_PERCENT=0
